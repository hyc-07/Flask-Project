# ─── Supabase (新加坡 ap-southeast-1) ───────────────────────
# 复制此文件为 .env 并填入真实值
# 在 Supabase → Settings → Database → Connection string → URI 中获取
# ⚠️ 端口 6543 = Transaction Pooler（推荐，配合 NullPool）
#    端口 5432 = Session Pooler / Direct

DATABASE_URL=postgresql://postgres.xxxxx:你的密码@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ─── Flask ──────────────────────────────────────────────────
SECRET_KEY=请换成随机长字符串-python-c-secrets-token-hex-32

# ─── 管理员账号 (db_migrate.py 使用) ────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设一个强密码
ADMIN_EMAIL=admin@example.com

# ─── 生产环境设 False，由 db_migrate.py 管表结构 ─────────────
AUTO_CREATE_DB=False
